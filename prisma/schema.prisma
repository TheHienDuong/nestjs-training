generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectRole {
  OWNER
  MEMBER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  ADMIN
}

// Reference — User is not yet wired to a Prisma-backed
// service (UsersService stays in-memory until authentication is implemented); this
// model only establishes the relations Project/Task/Comment need today.
model User {
  id            Int             @id @default(autoincrement())
  email         String          @unique
  name          String
  // Nullable for compatibility with existing legacy users until authentication
  // starts writing password hashes.
  passwordHash  String?
  role          UserRole        @default(CUSTOMER)
  restaurants   Restaurant[]
  password      String
  ownedProjects Project[]       @relation("ProjectOwner")
  memberships   ProjectMember[]
  assignedTasks Task[]          @relation("TaskAssignee")
  comments      Comment[]
  createdAt     DateTime        @default(now())
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId     Int
  members     ProjectMember[]
  tasks       Task[]
  createdAt   DateTime        @default(now())
}

// Explicit m-n (not implicit User[] / Project[]): ProjectMember carries a
// "role" field, so it needs its own model with a composite primary key.
model ProjectMember {
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  @@id([projectId, userId])
}

// project/assignee stay optional (Int?) — not required
// as in the  theory illustration — so the existing  CRUD contract
// (CreateTaskDto only sends `title`) keeps compiling and behaving unchanged.
model Task {
  id          Int          @id @default(autoincrement())
  title       String
  completed   Boolean      @default(false)
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   Int?
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId  Int?
  comments    Comment[]
  createdAt   DateTime     @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    Int
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  authorId  Int
  createdAt DateTime @default(now())
}

model Restaurant {
  id         Int        @id @default(autoincrement())
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  ownerId    Int
  name       String
  isArchived Boolean    @default(false)
  address    Address?
  categories Category[]
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())

  @@unique([ownerId, name])
  @@index([ownerId])
  @@index([isArchived])
}

model Category {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  restaurantId Int
  name         String
  isArchived   Boolean    @default(false)
  menuItems    MenuItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
  @@index([isArchived])
}

model MenuItem {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  restaurantId Int
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId   Int
  name         String
  priceMinor   Int
  currency     String     @db.Char(3)
  isAvailable  Boolean    @default(true)
  isArchived   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
  @@index([categoryId])
  @@index([restaurantId, isAvailable, isArchived])
}

model Address {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  restaurantId Int        @unique
  line1        String
  line2        String?
  city         String
  state        String?
  postalCode   String?
  countryCode  String     @db.Char(2)
}
