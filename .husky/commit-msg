# Git hook commit-msg — validates commit message content.
#
# commitlint cross-checks the commit message against the Conventional Commits standard.
# Incorrect format -> the commit is REJECTED immediately on your local machine, before it even enters the git history.
#
# Why hard blocking is enforced: git history is documentation. Editing the commit message after pushing
# requires rewriting history — which is far more costly than writing it correctly the first time.
pnpm exec commitlint --edit "$1"