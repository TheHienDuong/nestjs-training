# =============================================================================
# .env.example — BẢN MẪU, được commit vào git.
#
# File .env thật KHÔNG BAO GIỜ được commit (đã có trong .gitignore).
#
# Vì sao tách hai file:
#   - .env.example là TÀI LIỆU: cho biết app cần những biến nào để chạy.
#     Người mới clone repo (hoặc chính bạn trên máy khác) chỉ cần `cp .env.example .env`.
#   - .env là BÍ MẬT: chứa giá trị thật, chỉ tồn tại trên máy bạn.
#
# Quy tắc vàng: secret bị commit là secret đã bị lộ. Xoá ở commit sau không cứu
# được, vì nó vẫn nằm trong lịch sử git và mọi bản clone.
#
# Cách dùng:
#   cp .env.example .env
#   # rồi sửa giá trị trong .env
# =============================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL (khớp với docker-compose.yml) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs_training
# Cổng 5433 (không phải 5432) để tránh đụng PostgreSQL đang cài sẵn trên máy.
POSTGRES_PORT=5433

# Prisma đọc biến này. Chú ý cổng 5433 phải khớp POSTGRES_PORT ở trên.
# Dùng từ Lesson 07.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nestjs_training?schema=public"

# Database riêng cho e2e test — để test KHÔNG xoá dữ liệu bạn đang thao tác tay.
# Dùng từ Lesson 17.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/nestjs_training_test?schema=public"

# ---------- Redis (dùng từ Lesson 20) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# TTL mặc định của cache, đơn vị mili-giây.
CACHE_TTL=60000

# ---------- JWT (dùng từ Lesson 13) ----------
# CẢNH BÁO: giá trị dưới đây chỉ để chạy local.
# Sinh secret thật bằng:  openssl rand -base64 32
JWT_SECRET=thay-bang-secret-that-o-may-cua-ban
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=thay-bang-refresh-secret-khac-hoan-toan
JWT_REFRESH_EXPIRES_IN=7d

# Số vòng băm bcrypt. Cao hơn = an toàn hơn nhưng chậm hơn. 10-12 là khoảng hợp lý.
BCRYPT_SALT_ROUNDS=10

# ---------- Rate limiting (dùng từ Lesson 15) ----------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
