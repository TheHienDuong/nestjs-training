# =============================================================================
# .env.example — TEMPLATE, committed to git.
#
# The real .env file is NEVER committed (it is already in .gitignore).
#
# Why separate the two files:
#   - .env.example is DOCUMENTATION: it shows which variables the app needs to run.
#     Someone who just cloned the repository (or you on another machine) only needs `cp .env.example .env`.
#   - .env is SECRET: it contains real values and exists only on your machine.
#
# Golden rule: a committed secret is an exposed secret. Deleting it in a later commit does not help,
# because it remains in git history and every clone.
#
# Usage:
#   cp .env.example .env
#   # then edit the values in .env
# =============================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL (matches docker-compose.yml) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs_training
# Port 5433 (not 5432) avoids conflicting with PostgreSQL already installed on the machine.
POSTGRES_PORT=5433

# Prisma reads this variable. Note that port 5433 must match POSTGRES_PORT above.
# Used from Lesson 07.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nestjs_training?schema=public"

# Separate database for e2e tests — so tests DO NOT delete data you are working with manually.
# Used from Lesson 17.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/nestjs_training_test?schema=public"

# ---------- Redis (used from Lesson 20) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Default cache TTL, in milliseconds.
CACHE_TTL=60000

# ---------- JWT (used from Lesson 13) ----------
# WARNING: the values below are only for local use.
# Generate a real secret with:  openssl rand -base64 32
JWT_SECRET=replace-with-a-real-secret-on-your-machine
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-completely-different-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Number of bcrypt hashing rounds. Higher = safer but slower. 10-12 is a reasonable range.
BCRYPT_SALT_ROUNDS=10

# ---------- Rate limiting (used from Lesson 15) ----------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
