# =============================================================================
# .env.example — TEMPLATE, committed to git.
#
# The actual .env file is NEVER committed (it is already listed in .gitignore).
#
# Why split into two files:
#   - .env.example is DOCUMENTATION: it specifies the variables the app requires to run.
#     New users cloning the repo (or you on a different machine) only need to run `cp .env.example .env`.
#   - .env is SECRET: it contains real values, and only exists on your local machine.
#
# Golden rule: a committed secret is a leaked secret. Deleting it in a subsequent commit will not resolve the issue,
# because it still remains in the git history and all cloned copies.
#
# How to use:
#   cp .env.example .env
#   # then edit the values in .env
# =============================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL (matches docker-compose.yml) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs_training
# Port 5433 (not the default 5432) to avoid conflict with PostgreSQL pre-installed on your machine.
POSTGRES_PORT=5433

# Prisma reads this variable. Note that port 5433 must match the POSTGRES_PORT defined above.
# Used from Lesson 07.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/nestjs_training?schema=public"

# Dedicated database for e2e tests — to prevent tests from deleting data you are manually working with.
# Used from Lesson 17.DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/nestjs_training_test?schema=public"

# ---------- Redis (used from Lesson 20) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Default cache TTL, unit is milliseconds.
CACHE_TTL=60000

# ---------- JWT (used from Lesson 13) ----------
# WARNING: the value below is only for local use.
# Generate real secret using:  openssl rand -base64 32
JWT_SECRET=replace-with-real-secret-on-your-machine
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-completely-different-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Number of bcrypt hash rounds. Higher = more secure but slower. 10-12 is the reasonable range.
BCRYPT_SALT_ROUNDS=10

# ---------- Rate limiting (used from Lesson 15) ----------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100