# =============================================================================
# .env.example — TEMPLATE, committed to git.
#
# The real .env file is NEVER committed (it is already in .gitignore).
#
# Why two separate files:
#   - .env.example is DOCUMENTATION: it tells you which variables the app needs.
#     Someone cloning the repo (or you on another machine) only needs `cp .env.example .env`.
#   - .env is SECRETS: real values, exists only on your machine.
#
# Golden rule: a committed secret is a leaked secret. Deleting it in a later
# commit does not help, because it stays in git history and in every clone.
#
# How to use:
#   cp .env.example .env
#   # then edit the values in .env
# =============================================================================

# ---------- Application ----------
NODE_ENV=development
PORT=3000

# ---------- PostgreSQL (matches docker-compose.yml) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nestjs_task_management
# Port 5433 (not 5432) to avoid colliding with a PostgreSQL already installed on the machine.
POSTGRES_PORT=5433

# Prisma reads this variable. Note that port 5433 must match POSTGRES_PORT above.
# Used by the database configuration.
DATABASE_URL="postgresql://postgres:***@localhost:5433/nestjs_task_management?schema=public"

# Separate database for e2e tests — so tests do NOT delete the data you are working with.
# Used by end-to-end tests.
DATABASE_URL_TEST="postgresql://postgres:***@localhost:5433/nestjs_task_management_test?schema=public"

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Default cache TTL, in milliseconds.
CACHE_TTL=60000

# ---------- JWT ----------
# WARNING: the values below are for local development only.
# Generate a real secret with:  openssl rand -base64 32
JWT_SECRET=change-me-to-your-own-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-a-different-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt hashing rounds. Higher = more secure but slower. 10-12 is a reasonable range.
BCRYPT_SALT_ROUNDS=10

# ---------- Rate limiting ----------
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
